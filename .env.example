# Copy this file to .env and adjust if needed before running
# `docker compose up`. These defaults work out of the box for local dev.

# --- Warehouse (analytics) Postgres database ---
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=jobmarket
WAREHOUSE_PASSWORD=jobmarket

# --- Airflow metadata Postgres database ---
AIRFLOW_HOST=airflow-db
AIRFLOW_DB=airflow
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# --- Airflow webserver admin login (http://localhost:8080) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Airflow core ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
